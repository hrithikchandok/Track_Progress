# Public repo reading works with no environment configuration.
# Editing on the website (commits to GitHub) and private access need BOTH:
#   GITHUB_TOKEN        fine-grained token, this repo only, Contents: Read and write
#   VAULT_OWNER_USER_ID your Supabase user UUID (only this user can read/save)
# Never use a VITE_ prefix for secrets.
GITHUB_TOKEN=
VAULT_GITHUB_REPO=hrithikchandok/obsidian_vault
# Blank syncs every Markdown file. Set System-Design to limit to that folder.
VAULT_FOLDER=
OBSIDIAN_VAULT_NAME=obsidian_vault
# Optional private mode: Supabase Authentication > Users > your user's UUID
VAULT_OWNER_USER_ID=
