# Public repo works with no environment configuration.
# For private access, configure BOTH token and owner. Never use VITE_ for secrets.
GITHUB_TOKEN=
VAULT_GITHUB_REPO=hrithikchandok/obsidian_vault
# Blank syncs every Markdown file. Set System-Design to limit to that folder.
VAULT_FOLDER=
OBSIDIAN_VAULT_NAME=obsidian_vault
# Optional private mode: Supabase Authentication > Users > your user's UUID
VAULT_OWNER_USER_ID=
