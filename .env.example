# Server-side only. Never prefix GITHUB_TOKEN with VITE_.
GITHUB_TOKEN=
VAULT_GITHUB_REPO=hrithikchandok/obsidian_vault
# Blank syncs every Markdown file. Set System-Design to limit to that folder.
VAULT_FOLDER=
OBSIDIAN_VAULT_NAME=obsidian_vault
# Supabase Authentication > Users > your user's UUID
VAULT_OWNER_USER_ID=
